# Copy this to .env for local development. On Render, set these as
# Environment Variables in the dashboard instead — do not commit a real .env.

# Provided automatically by Render when you link a PostgreSQL database.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Your live site's URL(s), comma-separated. Use * only while testing.
ALLOWED_ORIGIN=*

# Credentials for the /admin submissions viewer.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-strong

PORT=3000
